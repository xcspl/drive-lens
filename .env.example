# drive-lens settings. Copy to .env and fill in; .env is never committed.

# The Google Drive folder to index (its share link).
DRIVE_LENS_SHARE_LINK=

# Describer: a vision model on an OpenAI-compatible chat API (MiniMax, OpenRouter, an llmhub proxy ...).
MINIMAX_API_KEY=
MINIMAX_MODEL=MiniMax-M3.1-Flash-Preview
MINIMAX_BASE_URL=https://api.minimax.io/v1
# low | medium | high | xhigh | max. MiniMax M3.x defaults to max (slow, many tokens).
MINIMAX_REASONING_EFFORT=medium

# Optional: a Google API key restricted to the Drive API. Empty = anonymous
# share-link listing (works for link-shared folders; previews either way).
GOOGLE_API_KEY=
