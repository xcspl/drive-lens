# ─────────────────────────────────────────────────────────────────────────────
# drive-lens settings
#
# Copy this file to `.env` in the repo root and fill it in:   cp .env.example .env
# `.env` is git-ignored: it holds your API key, never commit it.
#
# Both halves read this one file: the indexer (`drive-lens …`, Python) and
# the search app (`app/`, Electron). A real environment variable of the same
# name wins over the value here, e.g.  DRIVE_LENS_DB=/tmp/test.db drive-lens status
#
# Lines starting with # are comments; so is anything after " #" on a line.
# Relative paths are relative to this file's folder.
# ─────────────────────────────────────────────────────────────────────────────


# ── 1. The Google Drive folder ───────────────────────────────────────────────

# The folder to index: its share link, with sharing set to "Anyone with the
# link". Every subfolder is included; subfolders shared more narrowly are
# listed as "locked" by `drive-lens status` and skipped. A bare folder id works too.
#   DRIVE_LENS_SHARE_LINK=https://drive.google.com/drive/folders/1AbCdEfGhIjKlMnOpQrStUvWxYz012345?usp=sharing
DRIVE_LENS_SHARE_LINK=

# Optional. A Google Cloud API key (restricted to the Drive API) makes the
# listing go through the official Drive API instead of Drive's public folder
# pages, and adds file sizes and checksums, so a file edited in place is
# noticed. Leave empty to work without any Google account or key.
#   GOOGLE_API_KEY=AIzaSy...
GOOGLE_API_KEY=


# ── 2. The describing model (a vision LLM) ───────────────────────────────────
# Looks at each preview image and writes a title, description, tags and any
# text in the picture, for keyword search and for the result cards. It must
# accept images. One call per file; `drive-lens status` shows tokens used.

# Wire format of the API:
#   openai     → POST {BASE_URL}/chat/completions   OpenAI, MiniMax, OpenRouter,
#                Google Gemini (OpenAI-compatible endpoint), vLLM, Ollama, LM Studio …
#   anthropic  → POST {BASE_URL}/messages           Anthropic, and providers with an
#                Anthropic-compatible endpoint (e.g. MiniMax)
DRIVE_LENS_LLM_FORMAT=openai

# The API's base URL, without the /chat/completions or /messages part.
#   openai format:
#     https://api.minimax.io/v1                                  MiniMax
#     https://api.openai.com/v1                                  OpenAI
#     https://openrouter.ai/api/v1                               OpenRouter
#     https://generativelanguage.googleapis.com/v1beta/openai    Google Gemini
#     http://localhost:11434/v1                                  Ollama (local; run with --allow-no-key)
#   anthropic format:
#     https://api.anthropic.com/v1                               Anthropic
#     https://api.minimax.io/anthropic/v1                        MiniMax
DRIVE_LENS_LLM_BASE_URL=https://api.minimax.io/v1

# The API key for that provider (sent as "Authorization: Bearer …" in the
# openai format, as "x-api-key: …" in the anthropic format).
DRIVE_LENS_LLM_API_KEY=

# The model id, as the provider names it. It must take image input.
#   MiniMax-M3.1-Flash-Preview     MiniMax; fast and cheap; what this project was built with
#   gpt-5-mini                     OpenAI
#   openai/gpt-5-mini              the same through OpenRouter (provider/model)
#   claude-haiku-5-5               Anthropic
#   qwen3-vl:8b                    Ollama, on your own machine
DRIVE_LENS_LLM_MODEL=MiniMax-M3.1-Flash-Preview

# Reasoning effort, for models that think before answering. Empty = the
# provider's default. Sent as `reasoning_effort` (openai format) or
# `output_config.effort` (anthropic format); clear it if your provider
# rejects the field. MiniMax M3.x thinks at maximum effort when this is
# unset, which is slow and uses many tokens: medium is plenty for describing.
#   DRIVE_LENS_LLM_EFFORT=low | medium | high
DRIVE_LENS_LLM_EFFORT=medium


# ── 3. The embedding model (runs on your machine) ────────────────────────────
# Turns each image into a vector, for search by meaning. Downloaded from
# Hugging Face on first use. Runs on an Apple GPU, an NVIDIA GPU, or the CPU.

# The model the indexer embeds files with (sentence-transformers). It must
# put images and text in one vector space: files are indexed by their
# picture, queries are words. One index holds one model's vectors; to switch
# models, point DRIVE_LENS_DB at a new file and index again.
#   google/embeddinggemma-2      (default; ~3 GB, 768-d)
DRIVE_LENS_EMBED_MODEL=google/embeddinggemma-2

# The same model as the search app runs it (ONNX, text side only, ~314 MB),
# and the prompt it puts before every query. Change both only together with
# DRIVE_LENS_EMBED_MODEL; the defaults match EmbeddingGemma 2. v1 is built
# and tested with EmbeddingGemma 2, and built apps carry it inside: these
# two only apply when the app runs from source.
#   DRIVE_LENS_QUERY_MODEL=onnx-community/embeddinggemma-2-ONNX
#   DRIVE_LENS_QUERY_PREFIX=task: search result | query:
DRIVE_LENS_QUERY_MODEL=
DRIVE_LENS_QUERY_PREFIX=

# Precision of the indexer's model weights:
#   float32    default, exact
#   bfloat16   half the memory (EmbeddingGemma 2: ~2.8 GB instead of ~5 GB in use);
#              use it on 8 GB machines. Vectors differ from float32 by < 0.0002 (cosine).
DRIVE_LENS_DTYPE=float32

# Where the indexer's model runs. Empty = the best one found (mps → cuda → cpu).
#   DRIVE_LENS_DEVICE=cpu | mps | cuda
DRIVE_LENS_DEVICE=


# ── 4. The index (one SQLite file) ───────────────────────────────────────────

# The index file the indexer writes and the app opens. Empty = one index per
# Drive folder: data/<folder id>/index.db next to this file.
#   DRIVE_LENS_DB=data/my-drive.db
#   DRIVE_LENS_DB=/srv/indexes/photo-library.db
DRIVE_LENS_DB=
